generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model Category {
  id          String   @id @default(uuid())

  name        String   @unique
  slug        String   @unique

  description String?

  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Product {
  id            String          @id @default(uuid())

  categoryId    String

  name          String
  slug          String          @unique

  description   String

  sku           String          @unique

  price         Decimal         @db.Decimal(10,2)

  brand         String?

  thumbnail     String?

  weight        Decimal?        @db.Decimal(10,2)

  status        ProductStatus   @default(ACTIVE)

  category       Category        @relation(fields: [categoryId], references: [id])

  images         ProductImage[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([categoryId])
  @@index([name])
  @@index([sku])

  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid())

  productId   String

  imageUrl    String

  isPrimary   Boolean  @default(false)

  displayOrder Int     @default(0)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([productId])

  @@map("product_images")
}